# Copy this file to backend/.env (or export as real env vars) and fill in
# what you have. Everything is optional — the app runs fully in demo mode
# with zero keys, using deterministic mocked search + LLM responses so you
# can exercise the whole agent loop, RAG, and RL policy offline.

# --- LLM (Anthropic) ---------------------------------------------------
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=2048

# --- Web search (Tavily) ------------------------------------------------
TAVILY_API_KEY=

# --- Vector store --------------------------------------------------------
CHROMA_DIR=./data/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- Relational store ------------------------------------------------------
DATABASE_URL=sqlite:///./data/agent.db

# --- RL policy -----------------------------------------------------------
RL_POLICY_PATH=./data/rl_policy.json
RL_LR=0.05
RL_GAMMA=0.95
RL_ENTROPY_COEF=0.01

# --- Agent loop ------------------------------------------------------------
MAX_AGENT_STEPS=8
MAX_SOURCES=5

# --- Force demo mode even if ANTHROPIC_API_KEY is set ----------------------
FORCE_MOCK_LLM=false
